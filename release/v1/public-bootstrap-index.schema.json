{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ecorex.invalid/release/v1/public-bootstrap-index.schema.json",
  "title": "EcoreX v1 public Bootstrap discovery index",
  "$comment": "The release-key authority authenticates monotonic target identity. Bootstrap must also verify exact manifest and artifact bytes/signatures.",
  "oneOf": [
    {
      "$ref": "#/$defs/unpublished"
    },
    {
      "$ref": "#/$defs/published"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "minProperties": 7,
      "maxProperties": 7,
      "required": [
        "schema_version",
        "document_type",
        "trust",
        "status",
        "authority",
        "freshness",
        "release"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "document_type": { "const": "ecorex.public-bootstrap-discovery" },
        "trust": { "const": "untrusted-discovery-hint" },
        "status": { "enum": ["unpublished", "published"] },
        "authority": {},
        "freshness": {},
        "release": {}
      },
      "additionalProperties": false
    },
    "unpublished": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "unpublished" },
            "authority": { "type": "null" },
            "freshness": { "type": "null" },
            "release": { "type": "null" }
          }
        }
      ]
    },
    "published": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "published" },
            "authority": { "$ref": "#/$defs/authority" },
            "freshness": { "$ref": "#/$defs/freshness" },
            "release": { "$ref": "#/$defs/release" }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "value": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "contentEncoding": "base64"
        }
      },
      "additionalProperties": false
    },
    "authorityTarget": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": ["manifest_sha256", "release_id", "version", "build_digest"],
      "properties": {
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "release_id": { "type": "string", "pattern": "^release-stable-[0-9a-f]{24}$" },
        "version": { "type": "string", "pattern": "^1\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$" },
        "build_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": ["sequence", "revision", "target", "signature"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 999999999999 },
        "revision": { "type": "string", "pattern": "^release-stable-[0-9a-f]{24}$" },
        "target": { "$ref": "#/$defs/authorityTarget" },
        "signature": { "$ref": "#/$defs/signature" }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": ["authority_sha256", "issued_at", "expires_at", "signature"],
      "properties": {
        "authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "signature": { "$ref": "#/$defs/signature" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": ["source_id", "kind", "priority", "url"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "kind": { "enum": ["github-cn-mirror", "github-release", "ecorex-cdn"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 2 },
        "url": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/source" },
            { "properties": { "kind": { "const": "github-cn-mirror" }, "priority": { "const": 0 } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/source" },
            { "properties": { "kind": { "const": "github-release" }, "priority": { "const": 1 } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/source" },
            { "properties": { "kind": { "const": "ecorex-cdn" }, "priority": { "const": 2 } } }
          ]
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "manifest": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": ["file_name", "sha256", "signature", "sources"],
      "properties": {
        "file_name": { "const": "release-manifest.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "$ref": "#/$defs/signature" },
        "sources": { "$ref": "#/$defs/sources" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "required": [
        "artifact_id",
        "platform",
        "architecture",
        "file_name",
        "size_bytes",
        "sha256",
        "signature",
        "sources"
      ],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "platform": { "enum": ["windows", "macos"] },
        "architecture": { "enum": ["x64", "arm64"] },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
        },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "$ref": "#/$defs/signature" },
        "sources": { "$ref": "#/$defs/sources" }
      },
      "additionalProperties": false
    },
    "bootstrapArtifacts": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "properties": {
                "artifact_id": { "const": "bootstrap-windows-x64" },
                "platform": { "const": "windows" },
                "architecture": { "const": "x64" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "properties": {
                "artifact_id": { "const": "bootstrap-macos-arm64" },
                "platform": { "const": "macos" },
                "architecture": { "const": "arm64" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "properties": {
                "artifact_id": { "const": "bootstrap-macos-x64" },
                "platform": { "const": "macos" },
                "architecture": { "const": "x64" }
              }
            }
          ]
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "release": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "required": [
        "release_id",
        "version",
        "channel",
        "created_at",
        "build_digest",
        "publication_receipt_sha256",
        "manifest",
        "bootstrap_artifacts"
      ],
      "properties": {
        "release_id": { "type": "string", "pattern": "^release-stable-[0-9a-f]{24}$" },
        "version": { "type": "string", "pattern": "^1\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$" },
        "channel": { "const": "stable" },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "build_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "publication_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest": { "$ref": "#/$defs/manifest" },
        "bootstrap_artifacts": { "$ref": "#/$defs/bootstrapArtifacts" }
      },
      "additionalProperties": false
    }
  }
}
