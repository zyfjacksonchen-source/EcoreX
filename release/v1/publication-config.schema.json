{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecorex.invalid/schemas/publication-config-v1.json",
  "title": "EcoreX release publication configuration",
  "description": "Non-secret endpoint and environment-variable-name configuration. Bearer token values are never valid fields.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "github", "mirror", "cdn"],
      "properties": {
        "schema_version": {"const": 1},
        "github": {"$ref": "#/$defs/github"},
        "mirror": {"$ref": "#/$defs/mirror"},
        "cdn": {"$ref": "#/$defs/replica"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mirror"],
      "properties": {
        "schema_version": {"const": 2},
        "mirror": {"$ref": "#/$defs/replica"},
        "github": {"$ref": "#/$defs/github"},
        "cdn": {"$ref": "#/$defs/replica"}
      }
    }
  ],
  "$defs": {
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
    },
    "hostList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/host"
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repository",
        "token_env"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "token_env": {
          "$ref": "#/$defs/environmentName"
        }
      }
    },
    "mirror": {
      "oneOf": [
        {"$ref": "#/$defs/replica"},
        {"$ref": "#/$defs/readThroughMirror"}
      ]
    },
    "replica": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "endpoint",
        "allowed_hosts",
        "public_hosts",
        "token_env"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https://[^/?#]+/api/v1/releases$"
        },
        "allowed_hosts": {
          "$ref": "#/$defs/hostList"
        },
        "public_hosts": {
          "$ref": "#/$defs/hostList"
        },
        "token_env": {
          "$ref": "#/$defs/environmentName"
        }
      }
    },
    "readThroughMirror": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "mode",
        "public_hosts"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "mode": {
          "const": "github-read-through"
        },
        "public_hosts": {
          "$ref": "#/$defs/hostList"
        }
      }
    }
  }
}
