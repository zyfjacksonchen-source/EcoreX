{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecorex.local/schemas/release/v1/candidate-build-receipt.schema.json",
  "title": "EcoreX signed Candidate build receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_type", "status", "code", "commit_sha",
    "staging_provenance", "release_id", "version", "channel", "build_digest",
    "python_dependency_lock_sha256", "manifest_sha256", "web_tree_sha256",
    "stage_receipts", "artifacts", "signing", "signature"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "receipt_type": {"const": "ecorex-candidate-build"},
    "status": {"const": "passed"},
    "code": {"type": "null"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "staging_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_path", "workflow_run_id", "run_attempt", "receipt_sha256"],
      "properties": {
        "workflow_path": {"const": ".github/workflows/ecorex-v1-platform-stage.yml"},
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "release_id": {"type": "string", "pattern": "^release-(canary|stable)-[0-9a-f]{24}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "channel": {"enum": ["canary", "stable"]},
    "build_digest": {"$ref": "#/$defs/sha256"},
    "python_dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "web_tree_sha256": {"$ref": "#/$defs/sha256"},
    "stage_receipts": {
      "type": "object",
      "minProperties": 21,
      "maxProperties": 21,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_name", "size_bytes", "sha256"],
        "properties": {
          "file_name": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "operation_count", "executable_sha256", "adapter_sha256"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "operation_count": {"type": "integer", "minimum": 1},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "value": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    }
  }
}
