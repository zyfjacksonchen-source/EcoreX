{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ecorex.local/release/v1/bootstrap-index-publication-config.schema.json",
  "title": "EcoreX v1 Bootstrap index publication config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "endpoint",
    "allowed_hosts",
    "public_url",
    "public_hosts",
    "token_env"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+/api/v1/bootstrap-index$"
    },
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 253}
    },
    "public_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://.+/public-bootstrap-index\\.json$"
    },
    "public_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 253}
    },
    "token_env": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    }
  }
}
