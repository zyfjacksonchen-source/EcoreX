[Unit]
Description=EcoreX v1 Image Worker (%i slot)
After=network-online.target postgresql.service
Wants=network-online.target
RequiresMountsFor=/var/lib/ecorex

[Service]
Type=simple
User=ecorex-cloud
Group=ecorex-cloud
SupplementaryGroups=ecorex-storage
UMask=0077
EnvironmentFile=/etc/ecorex/cloud/config/image.env
EnvironmentFile=/var/lib/ecorex/secrets/image.secret.env
EnvironmentFile=/etc/ecorex/cloud/slots/%i/image.env
ExecStart=/opt/ecorex/cloud/slots/%i/current/venv/bin/python3.11 -m ecorex.image_orchestrator.production worker
Restart=on-failure
RestartSec=3s
TimeoutStopSec=180s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/ecorex/image /var/lib/ecorex/control-plane /var/lib/ecorex/cas

[Install]
WantedBy=multi-user.target
