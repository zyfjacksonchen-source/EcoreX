[Unit]
Description=EcoreX v1 Control Plane (%i slot)
After=network-online.target postgresql.service
Wants=network-online.target
RequiresMountsFor=/var/lib/ecorex

[Service]
Type=simple
User=ecorex-cloud
Group=ecorex-cloud
SupplementaryGroups=ecorex-storage
UMask=0077
EnvironmentFile=/etc/ecorex/cloud/config/control-plane.env
EnvironmentFile=/var/lib/ecorex/secrets/control-plane.secret.env
EnvironmentFile=/etc/ecorex/cloud/slots/%i/control-plane.env
ExecStart=/opt/ecorex/cloud/slots/%i/current/venv/bin/python3.11 -m ecorex.control_plane.production serve
Restart=on-failure
RestartSec=3s
TimeoutStopSec=150s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/ecorex/control-plane /var/lib/ecorex/cas /srv/ecorex-agent-download

[Install]
WantedBy=multi-user.target
