# Optional S3 mode only. Install as /var/lib/ecorex/secrets/minio.secret.env,
# root:ecorex-cloud 0640, on the attested encrypted volume.
MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME
MINIO_KMS_KES_ENDPOINT=https://REPLACE_WITH_KES_ENDPOINT
MINIO_KMS_KES_KEY_FILE=/run/credentials/minio/kes-client.key
MINIO_KMS_KES_CERT_FILE=/run/credentials/minio/kes-client.crt
MINIO_KMS_KES_CAPATH=/etc/ecorex/cloud/minio/kes-ca
MINIO_KMS_KES_KEY_NAME=ecorex-minio-sse
