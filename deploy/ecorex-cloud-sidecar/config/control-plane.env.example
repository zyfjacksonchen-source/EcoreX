ECOREX_CP_STORAGE_BACKEND=sqlite-wal
ECOREX_CP_REPLICA_COUNT=1
ECOREX_CP_DATABASE_PATH=/var/lib/ecorex/control-plane/control-plane.sqlite3
ECOREX_CP_BACKUP_DIRECTORY=/var/lib/ecorex/control-plane/backups
ECOREX_CP_SHARE_SPOOL_DIRECTORY=/var/lib/ecorex/control-plane/share-spool
ECOREX_CP_STORAGE_VOLUME_ID=REPLACE_WITH_ATTESTED_VOLUME_ID
ECOREX_CP_STORAGE_ENCRYPTION_AT_REST=true
ECOREX_CP_PUBLIC_SHARE_BASE_URL=https://dl.ecoremedia.net/s
ECOREX_CP_SHARE_STORAGE_MODE=attested-encrypted-local-cas
ECOREX_CP_LOCAL_CAS_ROOT=/var/lib/ecorex/cas
ECOREX_CP_LOCAL_CAS_ATTESTATION_PATH=/etc/ecorex/cloud/encrypted-volume-attestation.json
ECOREX_CP_LOCAL_CAS_ATTESTATION_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
ECOREX_CP_LOCAL_CAS_VOLUME_ID=REPLACE_WITH_ATTESTED_VOLUME_ID
ECOREX_CP_LOCAL_CAS_MACHINE_ID_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
ECOREX_CP_LOCAL_CAS_REPLICA_COUNT=1
ECOREX_CP_LOCAL_CAS_QUOTA_BYTES=274877906944
ECOREX_CP_LOCAL_CAS_MINIMUM_FREE_BYTES=10737418240
ECOREX_CP_LOCAL_CAS_OWNER_GID=REPLACE_WITH_ECOREX_STORAGE_GID
ECOREX_CP_LOCAL_CAS_MAX_OBJECT_BYTES=67108864
ECOREX_CP_LOCAL_CAS_MAX_OPEN_STREAMS=32
ECOREX_CP_AUTH_ISSUER=REPLACE_WITH_IDENTITY_ISSUER
ECOREX_CP_AUTH_AUDIENCE=ecorex-control-plane
ECOREX_CP_PUBLIC_BOOTSTRAP_INDEX_PATH=/srv/ecorex-agent-download/current/public-bootstrap-index.json
ECOREX_CP_PUBLIC_BOOTSTRAP_INDEX_URL=https://dl.ecoremedia.net/ecorex-agent/public-bootstrap-index.json
ECOREX_CP_PUBLIC_BOOTSTRAP_READBACK_HOSTS=dl.ecoremedia.net
ECOREX_CP_ADMIN_MANAGEMENT_ENABLED=true
ECOREX_CP_MODEL_ACTIVATION_TIMEOUT_SECONDS=180
ECOREX_CP_MODEL_PROVIDER_ORIGINS_JSON='{"ecorex_chat":"https://REPLACE_WITH_GPT_ORIGIN","deepseek_chat":"https://REPLACE_WITH_DEEPSEEK_ORIGIN","gemini_chat":"https://REPLACE_WITH_GEMINI_ORIGIN","doubao_chat":"https://REPLACE_WITH_DOUBAO_ORIGIN","ecorex_image":"https://REPLACE_WITH_IMAGE_PROVIDER_ORIGIN"}'
ECOREX_CP_BOOTSTRAP_FRESHNESS_AUTOMATION_ENABLED=true
ECOREX_CP_PUBLICATION_SIGNER_EXECUTABLE=/opt/ecorex/platform/signers/REPLACE_WITH_SIGNER
ECOREX_CP_PUBLICATION_SIGNER_EXECUTABLE_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
ECOREX_CP_PUBLICATION_SIGNER_KEY_ID=REPLACE_WITH_PUBLICATION_KEY_ID
ECOREX_CP_ROLLBACK_SIGNER_EXECUTABLE=/opt/ecorex/platform/signers/REPLACE_WITH_ROLLBACK_SIGNER
ECOREX_CP_ROLLBACK_SIGNER_EXECUTABLE_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
ECOREX_CP_ROLLBACK_SIGNER_KEY_ID=REPLACE_WITH_ROLLBACK_KEY_ID
