# Install as /var/lib/ecorex/secrets/control-plane.secret.env, root:ecorex-cloud 0640.
# Values shown here are deliberate blockers, not usable credentials.
ECOREX_CP_AUTH_PUBLIC_KEYS_JSON=REPLACE_ME
ECOREX_CP_RELEASE_PUBLIC_KEYS_JSON=REPLACE_ME
ECOREX_CP_PUBLICATION_PUBLIC_KEYS_JSON=REPLACE_ME
ECOREX_CP_ROLLBACK_SIGNER_PUBLIC_KEYS_JSON=REPLACE_ME
ECOREX_CP_SHARE_KEYRING_JSON=REPLACE_ME
ECOREX_CP_AUDIT_ENCRYPTION_KEY_B64=REPLACE_ME
ECOREX_CP_AUDIT_INTEGRITY_KEY_B64=REPLACE_ME
ECOREX_CP_MODEL_CONFIG_ENCRYPTION_KEY_B64=REPLACE_ME
# Keep these absent while ECOREX_CP_FEISHU_CONNECTOR_ENABLED=false. The app
# secret and the 32-byte token-envelope key are server-only values.
# ECOREX_CP_FEISHU_APP_ID=REPLACE_ME
# ECOREX_CP_FEISHU_APP_SECRET=REPLACE_ME
# ECOREX_CP_FEISHU_TOKEN_ENCRYPTION_KEY_B64=REPLACE_ME
# The publisher Bearer credential exists only in this server-side EnvironmentFile.
# Populate NEXT before rotating clients, then promote it to CURRENT after rollout.
ECOREX_CP_RELEASE_REPLICA_TOKEN_CURRENT=REPLACE_WITH_AT_LEAST_32_VISIBLE_ASCII_CHARACTERS
ECOREX_CP_RELEASE_REPLICA_TOKEN_NEXT=
# Emergency direct admission is disabled by default. These three values must
# be added together to this root-owned 0640 EnvironmentFile for one release,
# then removed after activation. A waived live gate is never recorded as PASS.
ECOREX_CP_DIRECT_RELEASE_ADMISSION_ENABLED=false
# ECOREX_CP_DIRECT_RELEASE_ID=release-stable-REPLACE_WITH_24_LOWERCASE_HEX
# ECOREX_CP_DIRECT_RELEASE_INSTRUCTION_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
