ECOREX_GATEWAY_STORAGE_BACKEND=sqlite-wal
ECOREX_GATEWAY_REPLICA_COUNT=1
ECOREX_GATEWAY_DATABASE_PATH=/var/lib/ecorex/gateway/gateway.sqlite3
ECOREX_GATEWAY_STORAGE_ENCRYPTION_AT_REST=true
ECOREX_GATEWAY_MODEL_MAPPING_JSON='{"ecorex-chat":"gpt-5.6-sol"}'
ECOREX_GATEWAY_PROVIDER_ORIGIN=https://main-provider.ecorex.internal
ECOREX_GATEWAY_PROVIDER_ALLOWED_ORIGINS_JSON='["https://main-provider.ecorex.internal"]'
ECOREX_GATEWAY_AUTH_ISSUER=REPLACE_WITH_IDENTITY_ISSUER
ECOREX_GATEWAY_AUTH_AUDIENCE=ecorex-gateway
ECOREX_GATEWAY_ADMIN_MANAGEMENT_ENABLED=true
ECOREX_GATEWAY_ADMIN_MANAGEMENT_DATABASE_PATH=/var/lib/ecorex/control-plane/control-plane.sqlite3
ECOREX_GATEWAY_MODEL_PROVIDER_ORIGINS_JSON='{"ecorex_chat":"https://main-provider.ecorex.internal","deepseek_chat":"https://deepseek-provider.ecorex.internal","gemini_chat":"https://gemini-provider.ecorex.internal","doubao_chat":"https://doubao-provider.ecorex.internal"}'
ECOREX_GATEWAY_PROVIDER_CA_BUNDLE_PATH=/var/lib/ecorex/config/provider-bridge-ca.pem
ECOREX_GATEWAY_PROVIDER_CA_BUNDLE_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
ECOREX_GATEWAY_CHAT_HANDOFF_TTL_SECONDS=3600
