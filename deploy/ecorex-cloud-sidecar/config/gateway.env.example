ECOREX_GATEWAY_STORAGE_BACKEND=sqlite-wal
ECOREX_GATEWAY_REPLICA_COUNT=1
ECOREX_GATEWAY_DATABASE_PATH=/var/lib/ecorex/gateway/gateway.sqlite3
ECOREX_GATEWAY_STORAGE_ENCRYPTION_AT_REST=true
ECOREX_GATEWAY_MODEL_MAPPING_JSON='{"ecorex-chat":"gpt-5.6-sol"}'
ECOREX_GATEWAY_PROVIDER_ORIGIN=https://REPLACE_WITH_PROVIDER_ORIGIN
ECOREX_GATEWAY_PROVIDER_ALLOWED_ORIGINS_JSON='["https://REPLACE_WITH_PROVIDER_ORIGIN"]'
ECOREX_GATEWAY_AUTH_ISSUER=REPLACE_WITH_IDENTITY_ISSUER
ECOREX_GATEWAY_AUTH_AUDIENCE=ecorex-gateway
ECOREX_GATEWAY_ADMIN_MANAGEMENT_ENABLED=true
ECOREX_GATEWAY_ADMIN_MANAGEMENT_DATABASE_PATH=/var/lib/ecorex/control-plane/control-plane.sqlite3
ECOREX_GATEWAY_MODEL_PROVIDER_ORIGINS_JSON='{"ecorex_chat":"https://REPLACE_WITH_GPT_ORIGIN","deepseek_chat":"https://REPLACE_WITH_DEEPSEEK_ORIGIN","gemini_chat":"https://REPLACE_WITH_GEMINI_ORIGIN","doubao_chat":"https://REPLACE_WITH_DOUBAO_ORIGIN"}'
ECOREX_GATEWAY_CHAT_HANDOFF_TTL_SECONDS=3600
