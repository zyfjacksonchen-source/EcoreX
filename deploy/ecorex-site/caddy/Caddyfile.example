# Example Caddy routes for EcoreX v0.1.18.
# Use this when you need a complete site block example.
# If www.ecoreai.cn already exists in your Caddyfile, copy/import
# ecorex-agent.routes.caddy inside that existing site block instead.

www.ecoreai.cn {
    encode zstd gzip

    import /srv/ecorex-agent-admin/server/caddy/ecorex-agent.routes.caddy
}
