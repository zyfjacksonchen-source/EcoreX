# Example Caddy routes for the EcoreX v1 public Bootstrap site.
# Use this when you need a complete site block example.
# If dl.ecoremedia.net already exists in your Caddyfile, copy/import
# ecorex-agent.routes.caddy inside that existing site block instead.

dl.ecoremedia.net {
    encode zstd gzip

    import /etc/ecorex/control-plane/ecorex-agent.routes.caddy
}

mvdcm.ecoremedia.net {
    redir https://dl.ecoremedia.net{uri} permanent
}
