# Import this file inside an existing site block to expose only the
# EcoreX WebUI Linux service under /ecorex-agent.

redir /ecorex-agent/app /ecorex-agent/app/

@ecorex_web_runtime {
    path /ecorex-agent/app/* /ecorex-agent/auth/* /ecorex-agent/message /ecorex-agent/upload /ecorex-agent/uploads/* /ecorex-agent/api/* /ecorex-agent/poll /ecorex-agent/stream /ecorex-agent/cancel /ecorex-agent/chat /ecorex-agent/config
}

handle @ecorex_web_runtime {
    uri strip_prefix /ecorex-agent
    reverse_proxy 127.0.0.1:9909 {
        flush_interval -1
        header_down X-Accel-Buffering no
        transport http {
            dial_timeout 10s
            read_timeout 600s
            write_timeout 600s
        }
    }
}
