# EcoreX v1 public Bootstrap site + release Control Plane Web console.
# Import this file inside the HTTPS site block. The Control Plane listens only
# on loopback; its own bearer authorization remains authoritative.

@ecorex_public_mutable path /ecorex-agent/ /ecorex-agent/index.html /ecorex-agent/public-bootstrap-index.json
header @ecorex_public_mutable Cache-Control "no-store"
header @ecorex_public_mutable X-Content-Type-Options "nosniff"
header @ecorex_public_mutable Referrer-Policy "no-referrer"
header @ecorex_public_mutable Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"

@ecorex_public_hashed path_regexp ecorex_public_hashed ^/ecorex-agent/(?:(?:site|styles)\.[0-9a-f]{12}\.(?:js|css)|assets/[A-Za-z0-9._-]+\.[0-9a-f]{12}\.(?:png|svg|webp|woff2))$
header @ecorex_public_hashed Cache-Control "public, max-age=31536000, immutable"
header @ecorex_public_hashed X-Content-Type-Options "nosniff"

@ecorex_release_assets path /ecorex-agent/downloads/* /ecorex-agent/releases/*
header @ecorex_release_assets Cache-Control "public, max-age=31536000, immutable"
header @ecorex_release_assets X-Content-Type-Options "nosniff"

redir /ecorex-agent /ecorex-agent/
redir /ecorex-agent/admin /ecorex-agent/admin/
redir /admin /ecorex-agent/admin/
redir /admin/* /ecorex-agent/admin/

# The v1 Control Plane serves the content-addressed administrator WebUI at
# /admin and owns every /api/v1/admin mutation. There is no parallel static
# v0.3 management console or public proxy to the user's local Agent Runtime.
handle /ecorex-agent/admin/* {
    uri strip_prefix /ecorex-agent
    reverse_proxy 127.0.0.1:18084
}

handle /api/v1/admin* {
    reverse_proxy 127.0.0.1:18084
}

handle_path /ecorex-agent/releases/* {
    root * /srv/ecorex-agent-download/v1-artifacts
    file_server
}

handle_path /ecorex-agent/* {
    root * /srv/ecorex-agent-download/current
    file_server
}
