# Import this file inside the existing www.ecoreai.cn site block.
# Replace <replace-with-caddy-hash> with: caddy hash-password

redir /ecorex-agent /ecorex-agent/
redir /ecorex-agent/admin /ecorex-agent/admin/
redir /ecorex-agent/app /ecorex-agent/app/

handle /ecorex-agent/admin/api/* {
    reverse_proxy 127.0.0.1:18084
}

handle /ecorex-agent/api/admin/* {
    reverse_proxy 127.0.0.1:18084
}

handle /ecorex-agent/client/* {
    reverse_proxy 127.0.0.1:18084
}

@ecorex_web_runtime {
    path /ecorex-agent/app/* /ecorex-agent/auth/* /ecorex-agent/message /ecorex-agent/upload /ecorex-agent/uploads/* /ecorex-agent/api/* /ecorex-agent/poll /ecorex-agent/stream /ecorex-agent/cancel /ecorex-agent/chat /ecorex-agent/config /ecorex-agent/assets/*
}
handle @ecorex_web_runtime {
    uri strip_prefix /ecorex-agent
    reverse_proxy 127.0.0.1:9909 {
        flush_interval -1
        header_down X-Accel-Buffering no
        transport http {
            dial_timeout 10s
            read_timeout 600s
            write_timeout 600s
        }
    }
}

handle_path /ecorex-agent/admin/* {
    basic_auth {
        admin <replace-with-caddy-hash>
    }
    root * /srv/ecorex-agent-download/current/admin
    file_server
}

handle_path /ecorex-agent/* {
    root * /srv/ecorex-agent-download/current
    file_server
}
