# Example Nginx locations for only the EcoreX WebUI Linux service.
# Place these inside the existing https server block.

set $ecorex_web_runtime http://127.0.0.1:9909;

location = /ecorex-agent/app {
    return 301 /ecorex-agent/app/;
}

location ^~ /ecorex-agent/client/ {
    proxy_pass http://127.0.0.1:18084/client/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location ~ ^/ecorex-agent/(stream|api/logs)$ {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    add_header X-Accel-Buffering no always;
}

location = /ecorex-agent/message {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location = /ecorex-agent/upload {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    client_max_body_size 256m;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location ~ ^/ecorex-agent/(app/|auth/|message$|upload$|uploads/|api/|poll$|cancel$|chat$|config$|assets/) {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}
