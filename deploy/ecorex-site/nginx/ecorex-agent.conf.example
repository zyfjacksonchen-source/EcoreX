# Example Nginx locations for EcoreX v0.2.2.
# Place these inside the existing https server block for mvdcm.ecoremedia.net.

set $ecorex_admin_api http://127.0.0.1:18084;
set $ecorex_web_runtime http://127.0.0.1:9909;

location = /ecorex-agent {
    return 301 /ecorex-agent/;
}

location = /ecorex-agent/admin {
    return 301 /ecorex-agent/admin/;
}

location = /ecorex-agent/app {
    return 301 /ecorex-agent/app/;
}

location ^~ /ecorex-agent/admin/api/ {
    proxy_pass $ecorex_admin_api/admin/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location ^~ /ecorex-agent/api/admin/ {
    proxy_pass $ecorex_admin_api/api/admin/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location ^~ /ecorex-agent/client/ {
    proxy_pass $ecorex_admin_api/client/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location = /ecorex-agent/stream {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    add_header X-Accel-Buffering no always;
}

location = /ecorex-agent/api/logs {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    add_header X-Accel-Buffering no always;
}

location ^~ /ecorex-agent/app/ {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location ^~ /ecorex-agent/auth/ {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location ^~ /ecorex-agent/uploads/ {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location ^~ /ecorex-agent/api/ {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location ^~ /ecorex-agent/assets/ {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location = /ecorex-agent/message {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location = /ecorex-agent/upload {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    client_max_body_size 256m;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location = /ecorex-agent/poll {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location = /ecorex-agent/cancel {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location = /ecorex-agent/chat {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location = /ecorex-agent/config {
    rewrite ^/ecorex-agent(/.*)$ $1 break;
    proxy_pass $ecorex_web_runtime;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location ^~ /ecorex-agent/admin/ {
    auth_basic "EcoreX Admin";
    auth_basic_user_file /etc/nginx/ecorex-admin.htpasswd;
    alias /srv/ecorex-agent-download/current/admin/;
    index index.html;
    autoindex off;
}

location ^~ /ecorex-agent/downloads/ {
    alias /srv/ecorex-agent-download/current/downloads/;
    autoindex off;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    add_header Accept-Ranges bytes always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    default_type application/octet-stream;
    types {
        application/zip zip;
        application/gzip gz;
        application/octet-stream exe dmg;
    }
}

location ^~ /ecorex-agent/ {
    alias /srv/ecorex-agent-download/current/;
    index index.html;
    autoindex off;
}
