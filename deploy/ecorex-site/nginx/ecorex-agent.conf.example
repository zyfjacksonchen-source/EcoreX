# EcoreX v1 public Bootstrap site + release Control Plane Web console.
# Place these locations inside the HTTPS server block.

set $ecorex_control_plane http://127.0.0.1:18084;

location = /ecorex-agent {
    return 301 /ecorex-agent/;
}

location = /ecorex-agent/admin {
    return 308 /admin/;
}

location ^~ /ecorex-agent/admin/ {
    return 308 /admin/;
}

location = /admin {
    return 301 /admin/;
}

# The Control Plane itself serves content-addressed /admin assets and validates
# the in-memory administrator bearer on every /api/v1/admin mutation.
location ^~ /admin/ {
    proxy_pass $ecorex_control_plane;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
}

location = /api/v1/admin {
    proxy_pass $ecorex_control_plane;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
}

location ^~ /api/v1/admin/ {
    proxy_pass $ecorex_control_plane;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
}

location = /ecorex-agent/ {
    alias /srv/ecorex-agent-download/current/index.html;
    default_type text/html;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" always;
}

location = /ecorex-agent/index.html {
    alias /srv/ecorex-agent-download/current/index.html;
    default_type text/html;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" always;
}

location = /ecorex-agent/public-bootstrap-index.json {
    alias /srv/ecorex-agent-download/current/public-bootstrap-index.json;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location ~ ^/ecorex-agent/(?<ecorex_public_asset>(?:site|styles)\.[0-9a-f]{12}\.(?:js|css)|assets/[A-Za-z0-9._-]+\.[0-9a-f]{12}\.(?:png|svg|webp|woff2))$ {
    alias /srv/ecorex-agent-download/current/$ecorex_public_asset;
    autoindex off;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location ^~ /ecorex-agent/downloads/ {
    alias /srv/ecorex-agent-download/current/downloads/;
    autoindex off;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    add_header Accept-Ranges bytes always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    default_type application/octet-stream;
    types {
        application/zip zip;
        application/gzip gz;
        application/octet-stream bin;
    }
}

location /ecorex-agent/ {
    alias /srv/ecorex-agent-download/current/;
    index index.html;
    autoindex off;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" always;
}
