[Unit]
Description=EcoreX Admin API
After=network.target

[Service]
Type=simple
User=ecorex
Group=ecorex
WorkingDirectory=/srv/ecorex-agent-admin/app
EnvironmentFile=/srv/ecorex-agent-admin/env/ecorex-admin-api.env
ExecStart=/usr/bin/python3 /srv/ecorex-agent-admin/app/ecorex_admin_api.py --host 127.0.0.1 --port 18084
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
